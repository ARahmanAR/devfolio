---
import { site } from '../data/site.ts';
const currentPath = Astro.url.pathname;
---

<header>
    <nav class="container desktop-nav liquid-glass">
        <a href="/" class="logo" aria-label="Abdur Rahman home"><span class="logo-mark">AR</span><span>{site.name}</span></a>
        <div class="links desktop-links">
            <a class:list={{ active: currentPath === '/' }} href="/">Home</a>
            <a class:list={{ active: currentPath === '/about' }} href="/about">About</a>
            <a class:list={{ active: currentPath.startsWith('/blog') }} href="/blog">Blog</a>
            <button class="theme-toggle liquid-control" type="button" aria-label="Switch theme" data-theme-toggle>◐</button>
        </div>
    </nav>
</header>

<nav class="mobile-dock liquid-glass" aria-label="Mobile navigation">
    <a class:list={{ active: currentPath === '/' }} href="/" aria-label="Home"><span class="nav-icon" aria-hidden="true">⌂</span><span>হোম</span></a>
    <a class:list={{ active: currentPath === '/about' }} href="/about" aria-label="About"><span class="nav-icon" aria-hidden="true">◎</span><span>পরিচিতি</span></a>
    <a class:list={{ active: currentPath.startsWith('/blog') }} href="/blog" aria-label="Blog"><span class="nav-icon" aria-hidden="true">▤</span><span>লেখা</span></a>
    <button class="nav-theme" type="button" aria-label="Switch theme" data-theme-toggle><span class="nav-icon" aria-hidden="true">◐</span><span>থিম</span></button>
</nav>

<style>
    header { position: sticky; top: 0; z-index: 10; padding-top: 14px; background: transparent; }
    nav{
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 20px;
    }
    .desktop-nav { position: relative; border-color: color-mix(in srgb, var(--accent) 18%, transparent); border-radius: 24px; box-shadow: 0 18px 50px var(--shadow), inset 0 1px 0 color-mix(in srgb, white 20%, transparent), 0 0 0 1px color-mix(in srgb, var(--accent) 5%, transparent); }
    .desktop-nav::before { content: ""; position: absolute; inset: 1px 18% auto; height: 1px; background: linear-gradient(90deg, transparent, color-mix(in srgb, white 45%, transparent), transparent); pointer-events: none; }
    .links {display: flex; align-items: center; gap: 22px; }
    .logo { display: inline-flex; align-items: center; gap: 9px; font-weight: 800; color: var(--text); letter-spacing: -0.04em; }
    .logo-mark { display: inline-grid; place-items: center; width: 38px; height: 38px; color: var(--accent-text); background: linear-gradient(145deg, var(--accent), var(--accent-strong)); border-radius: 11px; font-size: 0.78rem; letter-spacing: -0.08em; box-shadow: 0 5px 18px color-mix(in srgb, var(--accent) 25%, transparent); }
    .desktop-links a { color: var(--muted); font-size: 0.92rem; }
    .desktop-links a:hover, .desktop-links a.active { color: var(--text); }
    .desktop-links a.active::after { content: ""; display: block; height: 2px; margin-top: 5px; border-radius: 99px; background: var(--accent); }
    .theme-toggle { width: 36px; height: 36px; border: 1px solid var(--border); color: var(--text); cursor: pointer; font-size: 1rem; }
    .theme-toggle:hover { border-color: var(--accent); transform: rotate(18deg); }
    .mobile-dock { display: none; }
    @media (max-width: 600px) {
        header { position: relative; padding-top: 0; }
        .desktop-nav { display: none; }
        .desktop-links { display: none; }
        .mobile-dock { display: grid; position: fixed; left: 14px; right: 14px; bottom: calc(12px + env(safe-area-inset-bottom)); z-index: 20; grid-template-columns: repeat(4, 1fr); padding: 7px; }
        .mobile-dock a, .mobile-dock button { display: grid; place-items: center; gap: 2px; min-height: 54px; border: 0; background: transparent; color: var(--muted); font: inherit; font-size: 0.67rem; cursor: pointer; }
        .mobile-dock a.active, .mobile-dock button:hover { color: var(--text); }
        .mobile-dock a.active .nav-icon { color: var(--accent-text); background: var(--accent); box-shadow: 0 5px 18px color-mix(in srgb, var(--accent) 28%, transparent); }
        .nav-icon { display: grid; place-items: center; width: 29px; height: 29px; border-radius: 10px; font-size: 1.1rem; line-height: 1; }
    }
</style>
<script>
    document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => {
        toggle.addEventListener('click', () => {
            const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
            document.documentElement.dataset.theme = nextTheme;
            localStorage.setItem('theme', nextTheme);
        });
    });
</script>