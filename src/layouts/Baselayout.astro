---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>AR | {title} | {site.name}</title>
  </head>
  <body>
    <span class="cursor-dot" aria-hidden="true"></span>
    <span class="cursor-ring" aria-hidden="true"></span>
    <Header />
    <main class="container">
      <slot />
    </main>
    <Footer name={site.name} />
    <script>
      const root = document.documentElement;
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light' || savedTheme === 'dark') root.dataset.theme = savedTheme;

      const cursor = document.querySelector('.cursor-ring') as HTMLElement | null;
      const dot = document.querySelector('.cursor-dot') as HTMLElement | null;
      window.addEventListener('mousemove', (event) => {
        const x = `${event.clientX}px`;
        const y = `${event.clientY}px`;
        cursor?.animate({ left: x, top: y }, { duration: 320, fill: 'forwards' });
        if (dot) { dot.style.left = x; dot.style.top = y; }
        document.querySelectorAll('.interactive-card').forEach((card) => {
          const interactiveCard = card as HTMLElement;
          const bounds = interactiveCard.getBoundingClientRect();
          const x = event.clientX - bounds.left;
          const y = event.clientY - bounds.top;
          interactiveCard.style.setProperty('--pointer-x', `${x}px`);
          interactiveCard.style.setProperty('--pointer-y', `${y}px`);
          interactiveCard.style.setProperty('--rotate-y', `${((x / bounds.width) - 0.5) * 4}deg`);
          interactiveCard.style.setProperty('--rotate-x', `${((0.5 - y / bounds.height) * 4)}deg`);
        });
      });
      document.querySelectorAll<HTMLElement>('.btn, .theme-toggle, .nav-theme').forEach((button) => {
        button.addEventListener('pointermove', (event) => {
          const bounds = button.getBoundingClientRect();
          const x = event.clientX - bounds.left - bounds.width / 2;
          const y = event.clientY - bounds.top - bounds.height / 2;
          button.style.transform = `translate(${x * 0.12}px, ${y * 0.12}px)`;
        });
        button.addEventListener('pointerleave', () => { button.style.transform = ''; });
      });
      document.querySelectorAll<HTMLElement>('.btn, .theme-toggle, .nav-theme, .desktop-nav a, .mobile-dock a').forEach((element) => {
        element.classList.add('click-target');
        element.addEventListener('click', (event) => {
          const clickEvent = event as MouseEvent;
          element.classList.remove('is-clicking');
          void element.offsetWidth;
          element.classList.add('is-clicking');
          const bounds = element.getBoundingClientRect();
          const ripple = document.createElement('span');
          ripple.className = 'click-ripple';
          ripple.style.left = `${clickEvent.clientX - bounds.left}px`;
          ripple.style.top = `${clickEvent.clientY - bounds.top}px`;
          element.append(ripple);
          if (element instanceof HTMLAnchorElement && element.pathname.startsWith('/') && !clickEvent.metaKey && !clickEvent.ctrlKey && !clickEvent.shiftKey && !clickEvent.altKey) {
            clickEvent.preventDefault();
            window.setTimeout(() => { window.location.href = element.href; }, 220);
          }
          window.setTimeout(() => ripple.remove(), 560);
        });
      });
      document.querySelectorAll('a, button, .interactive-card').forEach((element) => {
        element.addEventListener('mouseenter', () => document.body.classList.add('cursor-hover'));
        element.addEventListener('mouseleave', () => document.body.classList.remove('cursor-hover'));
      });
      document.body.classList.add('cursor-ready');
    </script>
  </body>
</html>
