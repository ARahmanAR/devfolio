---
import BaseLayout from "../layouts/Baselayout.astro";
import { site } from "../data/site.ts";
---

<BaseLayout title="Home">
  <section class="hero">
  <h1>Hi, I'm {site.name} 👋</h1>
  <p class="muted">Role: {site.role}</p>
  <p>{site.bio}</p>
    {site.openToWork && <span>✅ I'm currently open to work opportunities!</span>}
  <ul class="socials">
    {
      site.socials.map((social) => (
        <li>
          <a href={social.url}>{social.label}</a>
        </li>
      ))
    }
  </ul>


  <a href="/blog" class="btn">
    Read My Blog
  </a>
  </section>
</BaseLayout>
