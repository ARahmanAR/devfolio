---
import BaseLayout from "../layouts/Baselayout.astro";
import { site } from "../data/site.ts";
---

<BaseLayout title="Home">
  <section class="hero">
  <p class="eyebrow">{site.role} · Personal space</p>
  <h1>ভাবনা থেকে<br /><span class="accent-text">বাস্তবতায়।</span></h1>
  <p class="muted hero-copy">আমি {site.name} — শেখা, তৈরি করা আর ওয়েবের সুন্দর সম্ভাবনাগুলো নিয়ে লিখি।</p>
    {site.openToWork && <span class="status-pill"><span></span> নতুন সুযোগের জন্য খোলা</span>}
  <ul class="socials">
    {
      site.socials.map((social) => (
        <li>
          <a href={social.url}>{social.label}</a>
        </li>
      ))
    }
  </ul>


  <a href="/blog" class="btn">
    আমার লেখা পড়ুন <span aria-hidden="true">↗</span>
  </a>
  </section>
</BaseLayout>
